{
  "dxt_version": "0.1",
  "name": "sam-mcp",
  "version": "0.0.1-alpha.0",
  "description": "The official MCP Server for the Sam API",
  "author": {
    "name": "Sam",
    "email": "apiteam@swagger.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DefinitelyATestOrg/sam-node.git"
  },
  "homepage": "https://github.com/DefinitelyATestOrg/sam-node/tree/main/packages/mcp-server#readme",
  "documentation": "https://docs.sam.com",
  "server": {
    "type": "node",
    "entry_point": "${__dirname}/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/index.js"],
      "env": {
        "API_KEY": "${user_config.API_KEY}"
      }
    }
  },
  "user_config": {
    "API_KEY": {
      "title": "api_key",
      "description": "API key used for authenticating requests via the Authorization header",
      "required": true,
      "type": "string"
    }
  },
  "tools_generated": true,
  "compatibility": {
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "keywords": ["api"]
}
